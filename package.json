{
  "name": "public-sector-ai-platform",
  "version": "0.0.0",
  "private": true,
  "description": "The permit desk: a small AI platform for fictional city permit reviews, built in the open for Latitude 10 Labs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "index": "node scripts/build-index.ts",
    "trace": "node --env-file=.env --import ./scripts/register.mjs scripts/trace.ts",
    "evals": "node --env-file=.env --import ./scripts/register.mjs scripts/evals.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@neon/config": "1.14.0",
    "@neon/env": "2.1.3",
    "@trigger.dev/build": "4.8.2",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.155.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true
  },
  "dependencies": {
    "@langfuse/client": "6.1.0",
    "@langfuse/core": "6.1.0",
    "@langfuse/otel": "6.1.0",
    "@langfuse/tracing": "6.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.8.0",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/otlp-exporter-base": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@trigger.dev/python": "4.8.2",
    "@trigger.dev/sdk": "4.8.2",
    "zod": "3.25.76"
  }
}
